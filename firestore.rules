rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allowlist of email addresses permitted to use the app.
    // Must match ALLOWED_EMAILS in docs/index.html.
    function isAllowed(email) {
      return email in [
        'wangylhs2@gmail.com',
        'nomi4458898@gmail.com'
      ];
    }

    // Each user's data lives at /users/{email}.
    // A signed-in user can only read/write the doc that matches their own email,
    // and only if their email is on the allowlist.
    match /users/{email} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == email
                         && isAllowed(request.auth.token.email);
    }
  }
}
